# Custom policy identity hashes the literal source bytes. Preserve the release bytes
# when cloning on Windows with core.autocrlf enabled.
/crates/custom-policy/policy/*.rs text eol=lf

# Authored source and generated module digests cover exact input bytes.
/crates/odc/policy/*.rs text eol=lf
/crates/odc/src/generated*.rs text eol=lf
/crates/odc/src/test_generated*.rs text eol=lf
